  {
    "id": "design-principle",
    "topic": "Design principle",
    "status": "Constrain an agent so that untrusted input cannot trigger consequential actions; six design patterns are published",
    "sources": [
      {
        "title": "design patterns paper",
        "url": "https://arxiv.org/abs/2506.08837"
      }
    ],
    "lastChecked": "2026-10-07"
  },
  {
    "id": "rule-of-thumb",
    "topic": "Rule of thumb",
    "status": "Agents Rule of Two: without supervision, a session should combine at most two of untrusted input, sensitive access and external action",
    "sources": [
      {
        "title": "Meta",
        "url": "https://ai.meta.com/blog/practical-ai-agent-security/"
      }
    ],
    "lastChecked": "2026-10-07"
  },
  {
    "id": "authorisation",
    "topic": "Authorisation",
    "status": "Authorisation must sit outside the model, because model output is untrusted however capable the model",
    "sources": [
      {
        "title": "CoSAI",
        "url": "https://www.coalitionforsecureai.org/zero-trust-for-ai-systems-why-authorization-cant-live-inside-the-model/"
      }
    ],
    "lastChecked": "2026-10-07"
  },
  {
    "id": "sandboxing",
    "topic": "Sandboxing",
    "status": "Isolation must be enforced by the operating system or hypervisor, not by instructions to the agent",
